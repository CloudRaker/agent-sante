{
  "name": "agent-sante",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "CloudRaker",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/sync-kb.mjs --if-present && vite build",
    "preview": "vite build && wrangler dev -c dist/agent_sante/wrangler.json --port 8788 --local-upstream localhost:8788",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "cf-typegen": "wrangler types --env-interface Env worker/env.d.ts",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:kb": "node scripts/sync-kb.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "hono": "4.13.13",
    "lucide-react": "1.58.0",
    "motion": "14.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "28.1.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.25.0"
}
